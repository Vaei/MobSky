// The sun's flare: how much of the sun the camera can see, and what the lens makes of it.
//
// Visibility is measured from the scene depth round the sun's disc, so opaque geometry such as a
// canopy frame or a passing hull covers it, and translucent glass, which writes no depth, does not.
// The planet's horizon and the cloud render pass's coverage cover it too. A material on glass can
// call MobSunVisibility itself and light its smudges by the same amount the flare is drawn at.

#pragma once

#include "/MobSky/Public/MobSky.ush"

#define MOB_SUN_TAPS 12

/** The sun on screen: its viewport UV, its disc's radius in UV of the screen's height, and how visible it is. */
struct FMobSun
{
	float2 UV;
	float RadiusUV;
	float OnScreen;
	float Visible;
};

float2 MobSunViewportToBuffer(float2 ViewportUV)
{
	return (ViewportUV * View.ViewSizeAndInvSize.xy + View.ViewRectMin.xy) * View.BufferSizeAndInvSize.zw;
}

/** Where the sun is on screen, as a viewport UV. False when it is behind the camera. */
bool MobSunProject(float3 KeyDir, out float2 UV)
{
	// A direction projects with w of zero: the point at infinity along it.
	const float4 Clip = mul(float4(KeyDir, 0.0f), View.TranslatedWorldToClip);
	UV = (Clip.xy / max(Clip.w, 1e-6f)) * float2(0.5f, -0.5f) + 0.5f;
	return Clip.w > 1e-4f;
}

/** How much of the sun stands above the planet's horizon, softened over its disc. */
float MobSunAboveHorizon(float3 KeyDir, float CamZ, float4 Planet, float SunRadius)
{
	const float Dip = MobSkyHorizonDip(CamZ - Planet.y, Planet.x);
	return smoothstep(Dip - SunRadius, Dip + SunRadius, KeyDir.z);
}

/** The share of taps over the sun's disc that see past everything opaque to the sky. */
float MobSunUnoccluded(float2 SunUV, float RadiusUV, float SkyDepth)
{
	const float Aspect = View.ViewSizeAndInvSize.y * View.ViewSizeAndInvSize.z;
	float Clear = 0.0f;

	UNROLL
	for (int Tap = 0; Tap < MOB_SUN_TAPS; ++Tap)
	{
		// A golden angle spiral covers the disc evenly with no two taps on one line.
		const float R = sqrt(((float)Tap + 0.5f) / MOB_SUN_TAPS) * RadiusUV;
		const float A = (float)Tap * 2.39996f;
		const float2 UV = saturate(SunUV + float2(cos(A) * Aspect, sin(A)) * R);
		Clear += CalcSceneDepth(MobSunViewportToBuffer(UV)) > SkyDepth ? 1.0f : 0.0f;
	}
	return Clear / MOB_SUN_TAPS;
}

/**
 * How visible the sun is to this view, 0 to 1.
 *
 * SunRadius is the disc's angular radius in radians. Off the screen there is no depth to look at,
 * so the sun fades out over Margin of the screen's height past its edge instead. Planet is the planet's
 * radius, the ground's world Z, and how much the cloud target is to be trusted as this view's clouds.
 */
FMobSun MobSunVisibility(float3 KeyDir, float CamZ, float4 Planet, float SunRadius, float SkyDepth, float Margin,
	Texture2D CloudTex, SamplerState CloudSampler)
{
	FMobSun Sun;
	Sun.Visible = 0.0f;
	Sun.OnScreen = 0.0f;

	// The disc's radius in UV of the screen's height, and never less than a couple of pixels.
	Sun.RadiusUV = max(tan(SunRadius) * View.ViewToClip[1][1] * 0.5f, 2.0f * View.ViewSizeAndInvSize.w);

	if (!MobSunProject(KeyDir, Sun.UV))
	{
		return Sun;
	}

	const float2 Outside = max(max(-Sun.UV, Sun.UV - 1.0f), 0.0f) * float2(View.ViewSizeAndInvSize.x * View.ViewSizeAndInvSize.w, 1.0f);
	Sun.OnScreen = 1.0f - saturate(length(Outside) / max(Margin, 1e-3f));
	if (Sun.OnScreen <= 0.0f)
	{
		return Sun;
	}

	float Visible = MobSunAboveHorizon(KeyDir, CamZ, Planet, SunRadius);
	if (Visible > 0.0f)
	{
		Visible *= MobSunUnoccluded(Sun.UV, Sun.RadiusUV, SkyDepth);
	}

	// The render pass's alpha is how much cloud covers the sky at that pixel.
	if (Planet.z > 0.0f && Visible > 0.0f)
	{
		const float Cover = CloudTex.SampleLevel(CloudSampler, saturate(Sun.UV), 0.0f).a;
		Visible *= lerp(1.0f, 1.0f - Cover, Planet.z);
	}

	Sun.Visible = Visible * Sun.OnScreen;
	return Sun;
}

/**
 * The camera's aperture: blade count, f-number, and the blades' rotation in radians. Stopped down, its
 * edges are straight and diffract into spikes; wide open, they curve and leave a round soft glow.
 */
struct FMobAperture
{
	float Blades;
	float FStop;
	float Rotation;
};

FMobAperture MobFlareAperture(float4 Packed)
{
	FMobAperture Aperture;
	Aperture.Blades = max(round(Packed.x), 3.0f);
	Aperture.FStop = max(Packed.y, 1.0f);
	Aperture.Rotation = Packed.z;
	return Aperture;
}

/** How round the blades are: 1 wide open, 0 by f/11, where they meet as a polygon. */
float MobFlareRoundness(FMobAperture Aperture)
{
	return 1.0f - smoothstep(4.0f, 11.0f, Aperture.FStop);
}

/** The aperture's radius towards Angle, as a share of its radius at a vertex. */
float MobFlareApertureRadius(float Angle, FMobAperture Aperture)
{
	const float Sector = 2.0f * PI / Aperture.Blades;
	const float Turn = frac((Angle - Aperture.Rotation) / Sector + 64.0f) - 0.5f;
	const float Polygon = cos(Sector * 0.5f) / cos(Turn * Sector);
	return lerp(Polygon, 1.0f, MobFlareRoundness(Aperture));
}

/** One ghost, an image of the aperture: a soft polygon with a brighter rim. */
float MobFlareGhost(float2 Delta, float Radius, FMobAperture Aperture)
{
	const float Edge = MobFlareApertureRadius(atan2(Delta.y, Delta.x), Aperture);
	const float D = length(Delta) / (Radius * Edge);
	const float Disc = 1.0f - smoothstep(0.75f, 1.0f, D);
	return Disc * (0.35f + 0.65f * smoothstep(0.4f, 0.95f, D));
}

/**
 * Diffraction off the blade edges: a spike pair per edge, so as many spikes as blades when the count is even
 * and twice as many when it is odd. The spikes grow out of the disc at its own brightness and thin to points,
 * so the sun and its star read as one shape, and the longer wavelengths reach further, which fringes the tips
 * warm. Opened up, the spikes give way to a soft glow. In units of the disc's brightness.
 */
float3 MobFlareStarburst(float2 ToSun, FMobAperture Aperture, float Length, float DiscRadius)
{
	const float D = length(ToSun);
	const float R = max(DiscRadius, 1e-4f);
	const bool bOdd = frac(Aperture.Blades * 0.5f) > 0.25f;
	const float Spikes = bOdd ? Aperture.Blades * 2.0f : Aperture.Blades;
	const float Sector = 2.0f * PI / Spikes;

	const float Turn = frac((atan2(ToSun.y, ToSun.x) - Aperture.Rotation) / (2.0f * PI) + 64.0f) * Spikes;
	const float Nearest = floor(Turn + 0.5f);
	const float Perp = D * abs(sin((Turn - Nearest) * Sector));

	// Opposite spikes come off the same edge; no two edges are cut quite alike.
	const float Edge = fmod(Nearest, Spikes * 0.5f);
	const float Jitter = 0.8f + 0.4f * frac(sin(Edge * 12.9898f + 3.1f) * 43758.5453f);

	const float Stopped = smoothstep(4.0f, 14.0f, Aperture.FStop);
	const float3 Wavelength = float3(1.15f, 1.0f, 0.82f);
	const float3 Reach = max(Length * (Aperture.FStop / 16.0f) * Jitter * Wavelength, R * 2.0f);
	const float3 Along = saturate(1.0f - D / Reach);

	// 1 at the disc's edge, so there is no seam between the sun and its spikes.
	const float Near = R / max(D, R);
	const float3 Width = 0.0007f * Wavelength + R * 0.6f * Near;
	const float3 Across = Perp / Width;
	const float3 Spike = exp(-Across * Across) * pow(Near, 1.4f) * Along * Along;

	const float Glow = exp(-max(D - R, 0.0f) / (R * 4.0f)) * (1.0f - Stopped) * 0.25f;

	return Spike * Stopped + Glow;
}

/**
 * The flare at a pixel, in the sun's colour, for a sun as visible as Sun says.
 *
 * Ghosts lie along the line from the sun through the screen's centre, a faint rainbow ring circles
 * the sun, and the aperture's starburst radiates from it. Amounts are ghosts, halo, starburst and the
 * starburst's length in screen heights at f/16. Aperture is blades, f-number and rotation. SunBrightness
 * is the sky's sun disc, which the starburst is scaled to so that it grows out of the disc.
 */
float3 MobLensFlare(float2 UV, FMobSun Sun, float3 SunColor, float4 Amounts, float4 PackedAperture, float SunBrightness)
{
	if (Sun.Visible <= 1e-3f)
	{
		return 0.0f;
	}

	const FMobAperture Aperture = MobFlareAperture(PackedAperture);
	const float2 Aspect = float2(View.ViewSizeAndInvSize.x * View.ViewSizeAndInvSize.w, 1.0f);
	const float2 Axis = 0.5f - Sun.UV;

	// Where along the axis (0 the sun, 1 its mirror through the centre), radius, brightness, and tint.
	const float4 Ghosts[6] =
	{
		float4(0.35f, 0.035f, 0.9f, 0.0f),
		float4(0.62f, 0.09f, 0.35f, 1.0f),
		float4(0.85f, 0.02f, 1.0f, 2.0f),
		float4(1.15f, 0.06f, 0.5f, 1.0f),
		float4(1.45f, 0.14f, 0.2f, 0.0f),
		float4(1.8f, 0.045f, 0.45f, 2.0f),
	};
	const float3 Tints[3] =
	{
		float3(1.0f, 0.55f, 0.45f),
		float3(0.45f, 0.8f, 1.0f),
		float3(0.7f, 1.0f, 0.6f),
	};

	float3 Ghost = 0.0f;
	UNROLL
	for (int Index = 0; Index < 6; ++Index)
	{
		const float2 Centre = Sun.UV + Axis * 2.0f * Ghosts[Index].x;
		Ghost += Tints[(int)Ghosts[Index].w] * Ghosts[Index].z
			* MobFlareGhost((UV - Centre) * Aspect, Ghosts[Index].y, Aperture);
	}

	// Ghosts brighten as the sun nears the centre, where the lens elements line up.
	Ghost *= 0.4f + 0.6f * (1.0f - saturate(length(Axis * Aspect) * 1.6f));

	const float2 ToSun = (UV - Sun.UV) * Aspect;
	const float D = length(ToSun);

	// A ring a third of the screen's height round the sun, with red outermost.
	const float3 RingRadius = float3(0.335f, 0.32f, 0.305f);
	const float3 RingOffset = (D - RingRadius) / 0.012f;
	const float3 Ring = exp(-RingOffset * RingOffset);

	// More of the sun showing throws longer spikes, as a brighter source does.
	const float3 Star = MobFlareStarburst(ToSun, Aperture, max(Amounts.w, 1e-3f) * sqrt(Sun.Visible), Sun.RadiusUV)
		* SunBrightness;

	return SunColor * Sun.Visible * (Ghost * Amounts.x + Ring * Amounts.y + Star * Amounts.z);
}
